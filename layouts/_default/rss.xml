{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" | safeHTML -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <description>{{ site.Params.description | default site.Params.subtitle }}</description>
    <link>{{ site.BaseURL }}</link>
    <atom:link href="{{ "feed.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- range first 10 (where site.RegularPages "Section" "posts") }}
    <item>
      <title>{{ .Title }}</title>
      <description>{{ .Content | plainify | htmlUnescape | transform.XMLEscape }}</description>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
    </item>
    {{- end }}
  </channel>
</rss>
